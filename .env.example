# Copy to .env (git-ignored) and fill in local values. Never commit real secrets.

# Django — required by every command (manage.py, tests, bot).
SECRET_KEY=change-me-to-a-long-random-string
# Local development only; leave False (the default) anywhere reachable from outside.
DEBUG=True
# Comma-separated host names the Django admin/webhook answer to, e.g. shop.example.com.
# Empty is fine for local DEBUG=True and for the bot, which serves no HTTP.
ALLOWED_HOSTS=
# HTTPS for the Django admin and webhook: True on every public deployment (redirect,
# secure cookies, HSTS). DJANGO_BEHIND_PROXY=True only behind a proxy that sets
# X-Forwarded-Proto. CSRF_TRUSTED_ORIGINS: comma-separated, e.g. https://shop.example.com.
DJANGO_HTTPS=False
DJANGO_BEHIND_PROXY=False
CSRF_TRUSTED_ORIGINS=

# PostgreSQL — DB_NAME is required. Use a role with LOGIN (and CREATEDB to run tests).
DB_NAME=telegram_bot
DB_USER=telegram_bot_test
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Telegram — required to run the bot (python bot.py).
TELEGRAM_TOKEN=
# Bootstrap Telegram admins (comma-separated user ids). Other admins are marked in Django
# admin (Utilizador > e_admin). After handover, keep only the reseller's id, or leave empty.
ADMIN_TELEGRAM_IDS=

# Stripe — use test-mode keys only. The bot needs the secret key and both URLs;
# the Django webhook needs STRIPE_WEBHOOK_SECRET (from `stripe listen` in local tests).
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_SUCCESS_URL=https://example.com/pagamento/sucesso
STRIPE_CANCEL_URL=https://example.com/pagamento/cancelado
